--- a/backend/auth.py
+++ b/backend/auth.py
@@ -3,8 +3,11 @@ from datetime import datetime, timedelta
 import bcrypt
 import os
 
-# Pulled from environment for production deployment
-SECRET_KEY = os.getenv("SECRET_KEY", "sentinel-super-secret-key-change-me")
+# SECRET_KEY signs every auth token issued by this service. It must be set
+# explicitly (e.g. `openssl rand -hex 32`) — there is no fallback, because a
+# shared default would let anyone who has read this file forge valid tokens
+# against any deployment that forgot to override it.
+SECRET_KEY = os.environ["SECRET_KEY"]
 ALGORITHM = "HS256"
 ACCESS_TOKEN_EXPIRE_MINUTES = 120 # Tokens last for 2 hours
 
