diff --git a/.env.example b/.env.example
index c1e6cdd..839eda4 100644
--- a/.env.example
+++ b/.env.example
@@ -1,5 +1,17 @@
+# Signs all backend auth JWTs. Required — the API will refuse to start
+# without it. Generate one with: openssl rand -hex 32
+SECRET_KEY=
+
 GROQ_API_KEY=your_groq_api_key_here
 
+# Set to "true" only for local/dev bring-up to auto-create a starter admin
+# account (see backend/create_default_user.py). Leave unset in production.
+CREATE_DEFAULT_ADMIN=
+# Optional — if CREATE_DEFAULT_ADMIN is true and this is left blank, a
+# random password is generated and printed once to the container logs
+# instead of using a fixed, guessable password.
+DEFAULT_ADMIN_PASSWORD=
+
 # Threat Intelligence & Vulnerability Enrichment API Keys
 # Optional but highly recommended to avoid strict rate limits on free tiers
 ALIENVAULT_OTX_KEY=
