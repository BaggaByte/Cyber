# Nexus AI Enterprise — Environment Configuration
# Copy this to .env and fill in your values

# ── AI Configuration ──────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
MAX_AGENT_CYCLES=5

# ── Security ──────────────────────────────────────────────────
NEXUS_API_KEY=nexus-dev-key-change-in-production
ENABLE_AUTH=false

# ── Server ───────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8081
DEBUG=false

# ── Database ─────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./nexus_enterprise.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nexus

# ── Scan Engine ──────────────────────────────────────────────
MAX_CONCURRENT_SCANS=2
RECON_MAX_DEPTH=3
RECON_MAX_PAGES=100
RECON_RATE_LIMIT_RPS=5.0
FUZZER_TIMEOUT=12.0
FUZZER_MAX_RETRIES=2

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
